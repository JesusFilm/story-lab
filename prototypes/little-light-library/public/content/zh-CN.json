  "characters": { "adam": "亚当", "eve": "夏娃", "noah": "挪亚" },
  "stories": [
    {
      "id": "eden",
      "title": "亚当、夏娃和伊甸园",
      "subtitle": "创世记2–3章的故事",
      "pages": [
        { "id": "eden-01", "title": "一个名叫伊甸的园子", "segments": [
          { "id": "s1", "text": "上帝创造了天地，又栽种了一个美丽的园子，名叫伊甸。祂把亚当安置在那里，让他照料园中的树木，也享受它们的果子。" },
          { "id": "s2", "text": "上帝把生命的气息吹进亚当里面。每一种生物都有自己的位置，但亚当需要一个同伴。" }
        ], "image": "assets/art/eden-01.webp", "passage": "创世记2:4–20" },
        { "id": "eden-02", "title": "一个同伴和一条命令", "segments": [
          { "id": "s1", "text": "上帝从亚当的肋旁造了夏娃，把她带到亚当面前。他们彼此相属，毫无羞耻，生活在平安中。" },
          { "id": "s2", "text": "上帝把园中的果子赐给他们，但有一棵树不可吃：分别善恶树。上帝警告他们不要吃那棵树的果子。" }
        ], "image": "assets/art/eden-02.webp", "passage": "创世记2:16–25" },
        { "id": "eden-03", "title": "蛇的疑问", "segments": [
          { "id": "s1", "text": "蛇和夏娃说话，质疑上帝的命令。它说，吃下那不可吃的果子，就会像上帝一样知道善恶。" },
          { "id": "s2", "text": "夏娃看见那果子好看，就摘下来吃了。她又给了亚当一些，亚当也吃了。" }
        ], "image": "assets/art/eden-03.webp", "passage": "创世记3:1–6" },
        { "id": "eden-04", "title": "羞耻与躲藏", "segments": [
          { "id": "s1", "text": "他们立刻知道自己是赤身露体的，羞耻使他们躲藏起来。他们把叶子缝在一起，遮盖身体。" },
          { "id": "s2", "text": "上帝呼唤时，亚当责怪夏娃，夏娃责怪蛇。他们之间的信任破裂了，自己的选择把罪带进了园子。" }
        ], "image": "assets/art/eden-04.webp", "passage": "创世记3:7–13" },
        { "id": "eden-05", "title": "选择的后果", "segments": [
          { "id": "s1", "text": "上帝说蛇必受咒诅。女人的后裔要伤蛇的头，蛇却要伤他的脚跟。" },
          { "id": "s2", "text": "上帝告诉夏娃，生育会带来痛苦；祂告诉亚当，土地会抵挡他的劳作。他们的生活从此带着忧伤和劳苦。" }
        ], "image": "assets/art/eden-05.webp", "passage": "创世记3:14–19" },
        { "id": "eden-06", "title": "离开园子", "segments": [
          { "id": "s1", "text": "上帝为亚当和夏娃做了衣服，给他们穿上。然后把他们赶出伊甸，免得他们摘取生命树的果子。" },
          { "id": "s2", "text": "基路伯和一把火焰的剑守住通往生命树的道路。亚当和夏娃不能回去了。" }
        ], "image": "assets/art/eden-06.webp", "passage": "创世记3:20–24" },
        { "id": "eden-07", "title": "伊甸以外的生活", "segments": [
          { "id": "s1", "text": "在伊甸以外，亚当和夏娃要在荆棘中辛苦劳作，才能得到食物。他们会渐渐衰老，归回亚当被造时所出于的尘土。" },
          { "id": "s2", "text": "失去园子是真实的痛苦，但上帝没有停止看顾他们。这个故事显明悖逆会带来伤害，也显明人需要上帝的拯救。" }
        ], "image": "assets/art/eden-07.webp", "passage": "创世记3:17–24" },
        { "id": "eden-08", "title": "延续下去的应许", "segments": [
          { "id": "s1", "text": "伊甸已经在他们身后，但上帝关于蛇的话带着得胜的应许。圣经继续讲述这个故事，也一直保存着这份盼望。" },
          { "id": "s2", "text": "亚当和夏娃不能靠自己修复已经破碎的关系。他们最初的选择提醒我们信靠上帝美善的道路，寻求祂的怜悯。" }
        ], "image": "assets/art/eden-08.webp", "passage": "创世记3:14–24" }
      ]
    },
    {
      "id": "noah",
      "title": "挪亚和大洪水",
      "subtitle": "创世记6–9章的故事",
      "pages": [
        { "id": "noah-01", "title": "被罪恶充满的世界", "segments": [
          { "id": "s1", "text": "上帝看见暴力和邪恶遍满大地。祂所造的美好世界充满了可怕的伤害。" },
          { "id": "s2", "text": "挪亚与上帝同行。上帝告诉他大洪水要来了，并指示他保护家人和动物的方法。" }
        ], "image": "assets/art/noah-01.webp", "passage": "创世记6:5–22" },
        { "id": "noah-02", "title": "建造巨大的方舟", "segments": [
          { "id": "s1", "text": "上帝吩咐挪亚建造一只巨大的方舟，里面有许多房间，足以承受不断上涨的洪水。挪亚遵照上帝的吩咐去做。" },
          { "id": "s2", "text": "他把方舟里面外面都封好，使水不能进入。这不是一只小小的玩具船，而是家人和许多生物的避难所。" }
        ], "image": "assets/art/noah-02.webp", "passage": "创世记6:14–22" },
        { "id": "noah-03", "title": "进入方舟", "segments": [
          { "id": "s1", "text": "各种动物成对来到挪亚那里，挪亚把它们带进方舟。他的妻子、儿子和儿媳妇也一起进去了。" },
          { "id": "s2", "text": "然后上帝把门关上。雨开始落下，方舟在外面的世界改变时等待着。" }
        ], "image": "assets/art/noah-03.webp", "passage": "创世记7:1–16" },
        { "id": "noah-04", "title": "洪水淹没大地", "segments": [
          { "id": "s1", "text": "雨下了四十昼夜，水越涨越高。方舟离开地面，开始漂浮。" },
          { "id": "s2", "text": "洪水淹没了大地，甚至盖过最高的山。在巨大的方舟里，挪亚的家人和动物们在黑暗中等待。" }
        ], "image": "assets/art/noah-04.webp", "passage": "创世记7:17–24" },
        { "id": "noah-05", "title": "一片盼望的叶子", "segments": [
          { "id": "s1", "text": "最后，上帝使风吹过，水开始退去。方舟停在亚拉腊山上。" },
          { "id": "s2", "text": "挪亚先放出一只乌鸦，又放出一只鸽子。鸽子带着一片新鲜的橄榄叶回来时，挪亚知道地面又要出现了。" }
        ], "image": "assets/art/noah-05.webp", "passage": "创世记8:1–12" },
        { "id": "noah-06", "title": "走进改变后的世界", "segments": [
          { "id": "s1", "text": "地面干了以后，上帝吩咐挪亚离开方舟。他的家人出来了，每一种动物也重新走上敞开的土地。" },
          { "id": "s2", "text": "留在方舟外的人被水冲走，淹死了。洪水是审判；获救的家人走进了一个肃穆而改变的世界。" }
        ], "image": "assets/art/noah-06.webp", "passage": "创世记7:21–23；8:13–19" },
        { "id": "noah-07", "title": "上帝的约", "segments": [
          { "id": "s1", "text": "挪亚筑了一座坛，敬拜上帝。上帝与挪亚、他的家人和一切有生命的活物立了约。" },
          { "id": "s2", "text": "上帝应许洪水不再毁灭地上所有的生命。祂把彩虹放在云中，作为应许的记号。" }
        ], "image": "assets/art/noah-07.webp", "passage": "创世记8:20–22；9:1–17" },
        { "id": "noah-08", "title": "记住彩虹", "segments": [
          { "id": "s1", "text": "彩虹成了上帝立约的明亮记号。每当彩虹出现，上帝记念自己的应许，祂的百姓也可以记住这应许。" },
          { "id": "s2", "text": "洪水的故事把悲伤、拯救和新的开始放在一起。洪水退去以后，挪亚的家人把上帝的怜悯带进世界。" }
        ], "image": "assets/art/noah-08.webp", "passage": "创世记9:8–17" }
      ]
    }
  ]
}
